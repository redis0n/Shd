@app.route('/')
def index():
    return render_template_string(HTML)

@app.route('/key', methods=['POST'])
def key_press():
    key = request.json.get('key')
    if key:
        send_key_to_system(key)
    return '', 204

@app.route('/text', methods=['POST'])
def type_text():
    text = request.json.get('text', '')
    if text:
        keyboard.type(text)  # pynput умеет печатать текст целиком
    return '', 204

@app.route('/mouse', methods=['POST'])
def mouse_move():
    dx = request.json.get('dx', 0)
    dy = request.json.get('dy', 0)
    # Получаем текущую позицию мыши и перемещаем
    x, y = mouse.position
    mouse.position = (x + dx, y + dy)
    return '', 204

@app.route('/click', methods=['POST'])
def mouse_click():
    button = request.json.get('button', 'left')
    btn_map = {
        'left': Button.left,
        'right': Button.right,
        'middle': Button.middle
    }
    mouse.click(btn_map.get(button, Button.left))
    return '', 204

@app.route('/scroll', methods=['POST'])
def mouse_scroll():
    direction = request.json.get('dir', 'down')
    # pynput: положительное значение = вверх, отрицательное = вниз
    scroll_amount = 120 if direction == 'up' else -120
    mouse.scroll(0, scroll_amount)
    return '', 204

def send_key_to_system(key):
    """Отправка клавиши через pynput"""
    # Специальные клавиши
    special_keys = {
        'enter': Key.enter,
        'space': Key.space,
        'backspace': Key.backspace,
        'tab': Key.tab,
        'escape': Key.esc,
        'up': Key.up,
        'down': Key.down,
        'left': Key.left,
        'right': Key.right
    }
    
    if key in special_keys:
        keyboard.press(special_keys[key])
        keyboard.release(special_keys[key])
    elif len(key) == 1:
        # Обычная клавиша
        keyboard.press(key)
        keyboard.release(key)
    else:
        # На случай, если пришло что-то другое
        keyboard.type(key)

