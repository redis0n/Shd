@app.route('/')
def index():
    return render_template_string(HTML)

@app.route('/key', methods=['POST'])
def key_press():
    key = request.json.get('key')
    if key:
        # Отправка клавиши на ПК
        send_key_to_system(key)
    return '', 204

@app.route('/text', methods=['POST'])
def type_text():
    text = request.json.get('text', '')
    if text:
        for ch in text:
            send_key_to_system(ch)
    return '', 204

@app.route('/mouse', methods=['POST'])
def mouse_move():
    dx = request.json.get('dx', 0)
    dy = request.json.get('dy', 0)
    move_mouse(dx, dy)
    return '', 204

@app.route('/click', methods=['POST'])
def mouse_click():
    button = request.json.get('button', 'left')
    click_mouse(button)
    return '', 204

@app.route('/scroll', methods=['POST'])
def mouse_scroll():
    direction = request.json.get('dir', 'down')
    scroll_mouse(direction)
    return '', 204

def send_key_to_system(key):
    """Отправка клавиши в ОС"""
    key_map = {
        'space': 'space', 'enter': 'enter', 'backspace': 'backspace',
        'tab': 'tab', 'escape': 'escape', 'up': 'up', 'down': 'down',
        'left': 'left', 'right': 'right'
    }
    if key in key_map:
        real_key = key_map[key]
    else:
        real_key = key
    
    system = platform.system()
    if system == 'Windows':
        # Через PowerShell
        import ctypes
        ctypes.windll.user32.keybd_event(ord(real_key[0]), 0, 0, 0)
        ctypes.windll.user32.keybd_event(ord(real_key[0]), 0, 2, 0)
    else:
        # Linux/Mac через xdotool (требуется установка)
        import subprocess
        subprocess.run(['xdotool', 'type', real_key])

def move_mouse(dx, dy):
    system = platform.system()
    if system == 'Windows':
        import ctypes
        ctypes.windll.user32.mouse_event(0x0001, int(dx), int(dy), 0, 0)
    else:
        import subprocess
        subprocess.run(['xdotool', 'mousemove_relative', '--', str(int(dx)), str(int(dy))])

def click_mouse(button):
    btn_code = {'left': 0x0002, 'right': 0x0008, 'middle': 0x0020}
    system = platform.system()
    if system == 'Windows':
        import ctypes
        ctypes.windll.user32.mouse_event(btn_code.get(button, 0x0002), 0, 0, 0, 0)
        ctypes.windll.user32.mouse_event(btn_code.get(button, 0x0002), 0, 0, 2, 0)
    else:
        import subprocess
        subprocess.run(['xdotool', 'click', '1' if button == 'left' else '3' if button == 'right' else '2'])

def scroll_mouse(direction):
    system = platform.system()
    if system == 'Windows':
        import ctypes
        ctypes.windll.user32.mouse_event(0x0800, 0, 0, 120 if direction == 'up' else -120, 0)
    else:
        import subprocess
        subprocess.run(['xdotool', 'click', '4' if direction == 'up' else '5'])

